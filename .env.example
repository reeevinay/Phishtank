# Server Configuration
PORT=3000
NODE_ENV=development
ROLE=all

# PostgreSQL 16 + pgvector (Leave unset locally to use zero-config SQLite WAL fallback)
# DATABASE_URL=postgresql://phishtank:phishtank_secret@localhost:5432/phishtank
# PG_SSL=false

# Redis / BullMQ Distributed Queue & Cache (Leave unset locally for in-memory fallback)
# REDIS_URL=redis://localhost:6379

# Python FastAPI Neuro-Symbolic ML Engine
ML_ENGINE_URL=http://localhost:8000

# Queue & Rate Limit
QUEUE_CONCURRENCY=5
RATE_LIMIT_RPM=180

# Optional API Key for multi-tenant production deployments
# API_KEY=your-secret-api-key
